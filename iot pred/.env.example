# Environment variables - copy this file to .env and update values

# App
APP_NAME=IoT Predictive Maintenance
APP_ENV=development
DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/iot_predictive_maintenance

# JWT
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Logging
LOG_LEVEL=INFO

# API
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
